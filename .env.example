# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WHATSAPP_ACCESS_TOKEN: Permanent System User Token from Meta Business Manager (WhatsApp Cloud API).
WHATSAPP_ACCESS_TOKEN=

# WHATSAPP_PHONE_NUMBER_ID: Phone Number ID from Meta Developer Portal -> WhatsApp -> API Setup.
WHATSAPP_PHONE_NUMBER_ID=

# WHATSAPP_VERIFY_TOKEN: Custom secret string you enter in Meta Webhook Configuration to verify GET /api/whatsapp/webhook.
WHATSAPP_VERIFY_TOKEN=

# WHATSAPP_APP_SECRET: Meta App Secret used to verify X-Hub-Signature-256 webhook signatures (recommended for production).
WHATSAPP_APP_SECRET=

# PORT: HTTP server port (defaults to 3000).
PORT=3000

# DATA_DIR: Directory where persistent chats, tickets, and config (store.json) are saved.
# On Dokploy, mount a persistent Docker Volume to /app/data so chats survive redeploys.
DATA_DIR=/app/data

